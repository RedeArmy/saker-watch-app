# Settings of the application containers that are not secrets of the datastores. Copy this file to app.env in this directory (the copy is not in the repository)
# and fill what the host needs. Every name is a configuration key with "__" for ":". The API and the worker read it; a key that is not set keeps its default.

# Which provider serves each market. Without a line a market is disabled. A market routed to twelvedata needs the key below.
# MarketData__Providers__Markets__XNAS=twelvedata
# MarketData__Providers__Markets__XNYS=twelvedata
# MarketData__Providers__Markets__ARCX=twelvedata
# TwelveData__ApiKey=

# The most listings the shared catalog holds (ADR-0051): (CreditsPerDay - OnDemandCreditsPerDay) / 2 less some room. The host refuses a cap its credits cannot refresh.
# MarketData__Lookup__MaxCatalogListings=250
# TwelveData__CreditsPerDay=800
# TwelveData__OnDemandCreditsPerDay=200
# TwelveData__CreditsPerMinute=8
