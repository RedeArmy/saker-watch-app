{
  "$comment": "Provisional shape of the structured assessments of RFC-0002 / ADR-0008: the model rates criteria with evidence and the deterministic scoring step (not the model) derives the score. TODO(owner: Eder, rfc-0002): replace the criteria with the final rubric.",
  "type": "object",
  "required": ["stock", "risk_scan", "conviction", "catalysts"],
  "additionalProperties": false,
  "properties": {
    "stock": { "type": "string", "minLength": 1, "maxLength": 40 },
    "risk_scan": {
      "type": "object",
      "required": ["assessments", "red_flags"],
      "additionalProperties": false,
      "properties": {
        "assessments": {
          "type": "array", "minItems": 1, "maxItems": 8,
          "items": {
            "type": "object", "required": ["criterion", "rating", "evidence"], "additionalProperties": false,
            "properties": {
              "criterion": { "type": "string", "minLength": 1, "maxLength": 60 },
              "rating": { "enum": ["low", "medium", "high", "unknown"] },
              "evidence": { "type": "string", "minLength": 1, "maxLength": 400 }
            }
          }
        },
        "red_flags": {
          "type": "array", "maxItems": 6,
          "items": {
            "type": "object", "required": ["flag", "severity", "evidence"], "additionalProperties": false,
            "properties": {
              "flag": { "type": "string", "minLength": 1, "maxLength": 120 },
              "severity": { "enum": ["minor", "moderate", "severe"] },
              "evidence": { "type": "string", "minLength": 1, "maxLength": 400 }
            }
          }
        }
      }
    },
    "conviction": {
      "type": "object",
      "required": ["assessments"],
      "additionalProperties": false,
      "properties": {
        "assessments": {
          "type": "array", "minItems": 1, "maxItems": 8,
          "items": {
            "type": "object", "required": ["criterion", "rating", "evidence"], "additionalProperties": false,
            "properties": {
              "criterion": { "type": "string", "minLength": 1, "maxLength": 60 },
              "rating": { "enum": ["weak", "mixed", "strong", "unknown"] },
              "evidence": { "type": "string", "minLength": 1, "maxLength": 400 }
            }
          }
        }
      }
    },
    "catalysts": {
      "type": "array", "maxItems": 5,
      "items": {
        "type": "object", "required": ["name", "probability_band", "horizon", "evidence"], "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "probability_band": { "enum": ["low", "medium", "high"] },
          "horizon": { "enum": ["under_3_months", "3_to_12_months", "over_12_months"] },
          "evidence": { "type": "string", "minLength": 1, "maxLength": 400 }
        }
      }
    }
  }
}
