{
  "openapi": "3.1.1",
  "info": {
    "title": "Saker Watch API",
    "description": "Personal stock watchlist and research assistant. Signals are research aids, never financial advice.",
    "version": "1.0"
  },
  "paths": {
    "/v1/me": {
      "get": {
        "tags": [
          "Me"
        ],
        "summary": "Get the current user",
        "description": "Returns the profile of the authenticated caller. The account is created on the first authenticated request.",
        "operationId": "GetMe",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/v1/me/preferences": {
      "put": {
        "tags": [
          "Me"
        ],
        "summary": "Set the current user\u0027s preferences",
        "description": "Sets the preferred UI locale and returns the updated profile. Requires an Idempotency-Key: repeating the request with the same key and body replays the first response (Idempotent-Replayed: true); the same key with a different body is rejected with 422.",
        "operationId": "UpdateMyPreferences",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "Client-generated key (16-64 letters, digits, \u0027-\u0027 or \u0027_\u0027) that makes the request safe to retry. A repeat with the same key and body replays the first response.",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z0-9_-]{16,64}$",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePreferencesRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/v1/stocks/search": {
      "get": {
        "tags": [
          "Stocks"
        ],
        "summary": "Search stocks to add to the watchlist",
        "description": "Finds stocks in the enabled markets by ticker or name, an exact ticker first. The market in each match is the canonical one to use in the watchlist routes. Searches are limited per user and, together, per minute and per day; a busy answer carries Retry-After. This is a research aid, not a recommendation.",
        "operationId": "SearchStocks",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StockSearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/v1/watchlist": {
      "get": {
        "tags": [
          "Watchlist"
        ],
        "summary": "List the watchlist",
        "description": "The caller\u0027s stocks with the newest price, how current it is (priceStatus, and staleSince when the last known price is shown) and the performance windows 1D, 1W, 1M, 3M, 6M, YTD, 1Y and 5Y, computed from adjusted closes in the stock\u0027s own currency; a window without enough history carries a reason instead of a number. Filter by market, assetType, q (ticker or name) and priceStatus; sort by ticker, name, market, createdAt, price or a window (a missing value sorts last); page with limit (1 to 100, default 50) and offset. The answer carries an ETag: send it back in If-None-Match to get 304 when nothing changed. Informational only, not financial advice.",
        "operationId": "GetWatchlist",
        "parameters": [
          {
            "name": "sort",
            "in": "query",
            "description": "",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "order",
            "in": "query",
            "description": "",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "market",
            "in": "query",
            "description": "",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "assetType",
            "in": "query",
            "description": "",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "description": "",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "priceStatus",
            "in": "query",
            "description": "",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WatchlistPageResponse"
                }
              }
            }
          },
          "304": {
            "description": "Not Modified"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/v1/watchlist/items/{market}/{ticker}": {
      "put": {
        "tags": [
          "Watchlist"
        ],
        "summary": "Put a stock on the watchlist",
        "description": "Adds the stock to the caller\u0027s watchlist with these notes and target price, or replaces the notes and target of the item already there: the same request twice leaves the same state, so it needs no Idempotency-Key. A stock the catalog does not have yet is registered from the provider\u0027s answer for that exact market and ticker and its history is queued; if the provider cannot confirm it the answer is 503 and nothing is stored. Returns 201 when the stock was added and 200 when an item was updated.",
        "operationId": "PutWatchlistItem",
        "parameters": [
          {
            "name": "market",
            "in": "path",
            "description": "",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ticker",
            "in": "path",
            "description": "",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/PutWatchlistItemRequest"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WatchlistItemResponse"
                }
              }
            }
          },
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WatchlistItemResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "delete": {
        "tags": [
          "Watchlist"
        ],
        "summary": "Take a stock off the watchlist",
        "description": "Removes the stock from the caller\u0027s watchlist and from every portfolio it was in. Removing a stock that is not there is not an error: the answer is 204 either way.",
        "operationId": "RemoveWatchlistItem",
        "parameters": [
          {
            "name": "market",
            "in": "path",
            "description": "",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ticker",
            "in": "path",
            "description": "",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "MeResponse": {
        "required": [
          "id",
          "displayName",
          "email",
          "locale",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Internal user id (UUIDv7), never the identity provider\u0027s subject.",
            "format": "uuid"
          },
          "displayName": {
            "type": [
              "null",
              "string"
            ],
            "description": "Name sent by the identity provider, if any."
          },
          "email": {
            "type": [
              "null",
              "string"
            ],
            "description": "Email sent by the identity provider, if any."
          },
          "locale": {
            "type": "string",
            "description": "Preferred UI locale (BCP 47), for example \u0060es-GT\u0060."
          },
          "createdAt": {
            "type": "string",
            "description": "When the account was first seen (ISO-8601 UTC).",
            "format": "date-time"
          }
        },
        "description": "The caller\u0027s own profile."
      },
      "PriceResponse": {
        "required": [
          "value",
          "date",
          "isFinal"
        ],
        "type": "object",
        "properties": {
          "value": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "type": "string",
            "description": "The close as traded, in the stock\u0027s currency (a decimal string).",
            "format": "decimal"
          },
          "date": {
            "type": "string",
            "description": "The trading day (ISO-8601 date).",
            "format": "date"
          },
          "isFinal": {
            "type": "boolean",
            "description": "False while the day may still change."
          }
        },
        "description": "The newest stored bar of a stock."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PutWatchlistItemRequest": {
        "required": [
          "notes",
          "targetPrice"
        ],
        "type": "object",
        "properties": {
          "notes": {
            "type": [
              "null",
              "string"
            ],
            "description": "Notes, up to 2000 characters, or null."
          },
          "targetPrice": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "type": [
              "null",
              "string"
            ],
            "description": "Target price greater than zero with at most eight decimals, or null.",
            "format": "decimal"
          }
        },
        "description": "Body of \u0060PUT /v1/watchlist/items/{market}/{ticker}\u0060. Both fields replace what is stored; leaving one out clears it."
      },
      "StockCandidateResponse": {
        "required": [
          "market",
          "ticker",
          "name",
          "currency",
          "assetType"
        ],
        "type": "object",
        "properties": {
          "market": {
            "type": "string",
            "description": "Canonical market code (MIC), for example \u0060XNAS\u0060."
          },
          "ticker": {
            "type": "string",
            "description": "Ticker on that market."
          },
          "name": {
            "type": "string",
            "description": "Instrument name as the provider reports it."
          },
          "currency": {
            "type": "string",
            "description": "Trading currency (ISO 4217)."
          },
          "assetType": {
            "type": "string",
            "description": "Kind of instrument: \u0060equity\u0060, \u0060etf\u0060 or \u0060other\u0060."
          }
        },
        "description": "A stock found by a search."
      },
      "StockSearchResponse": {
        "required": [
          "items"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StockCandidateResponse"
            },
            "description": "The matches, an exact ticker first."
          }
        },
        "description": "Result of \u0060GET /v1/stocks/search\u0060."
      },
      "UpdatePreferencesRequest": {
        "required": [
          "locale"
        ],
        "type": "object",
        "properties": {
          "locale": {
            "type": "string",
            "description": "Preferred UI locale: \u0060es-GT\u0060 or \u0060en-US\u0060."
          }
        },
        "description": "Body of \u0060PUT /v1/me/preferences\u0060."
      },
      "WatchlistEntryResponse": {
        "required": [
          "id",
          "stock",
          "notes",
          "targetPrice",
          "createdAt",
          "updatedAt",
          "priceStatus",
          "price",
          "staleSince",
          "windows"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Item id.",
            "format": "uuid"
          },
          "stock": {
            "description": "The stock.",
            "$ref": "#/components/schemas/WatchlistStockResponse"
          },
          "notes": {
            "type": [
              "null",
              "string"
            ],
            "description": "The caller\u0027s notes, or null."
          },
          "targetPrice": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "type": [
              "null",
              "string"
            ],
            "description": "The caller\u0027s target price, or null. A note, never an order.",
            "format": "decimal"
          },
          "createdAt": {
            "type": "string",
            "description": "When the stock was added (ISO-8601 UTC).",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "description": "When the item last changed (ISO-8601 UTC).",
            "format": "date-time"
          },
          "priceStatus": {
            "type": "string",
            "description": "\u0060current\u0060, \u0060stale\u0060 (the last known price is shown), \u0060pending\u0060 (no history yet) or \u0060unavailable\u0060 (loading failed for good)."
          },
          "price": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PriceResponse"
              }
            ],
            "description": "The newest stored bar, or null when there is none."
          },
          "staleSince": {
            "type": [
              "null",
              "string"
            ],
            "description": "When the price went stale (ISO-8601 UTC), only for \u0060stale\u0060.",
            "format": "date-time"
          },
          "windows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WindowResponse"
            },
            "description": "The eight performance windows, in order."
          }
        },
        "description": "A stock on the caller\u0027s watchlist as the list shows it."
      },
      "WatchlistItemResponse": {
        "required": [
          "id",
          "stock",
          "notes",
          "targetPrice",
          "createdAt",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Item id.",
            "format": "uuid"
          },
          "stock": {
            "description": "The stock.",
            "$ref": "#/components/schemas/WatchlistStockResponse"
          },
          "notes": {
            "type": [
              "null",
              "string"
            ],
            "description": "The caller\u0027s notes, or null."
          },
          "targetPrice": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "type": [
              "null",
              "string"
            ],
            "description": "The caller\u0027s target price in the stock\u0027s currency, or null. A note, never an order.",
            "format": "decimal"
          },
          "createdAt": {
            "type": "string",
            "description": "When the stock was added (ISO-8601 UTC).",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "description": "When the item last changed (ISO-8601 UTC).",
            "format": "date-time"
          }
        },
        "description": "A stock on the caller\u0027s watchlist."
      },
      "WatchlistPageResponse": {
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WatchlistEntryResponse"
            },
            "description": "The entries of the page."
          },
          "total": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "How many stocks match the filters, in all pages.",
            "format": "int32"
          },
          "limit": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Items per page asked for.",
            "format": "int32"
          },
          "offset": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Items skipped.",
            "format": "int32"
          }
        },
        "description": "A page of the caller\u0027s watchlist."
      },
      "WatchlistStockResponse": {
        "required": [
          "id",
          "market",
          "ticker",
          "name",
          "currency",
          "assetType"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Catalog id of the stock.",
            "format": "uuid"
          },
          "market": {
            "type": "string",
            "description": "Canonical market code (MIC)."
          },
          "ticker": {
            "type": "string",
            "description": "Ticker on that market."
          },
          "name": {
            "type": "string",
            "description": "Instrument name."
          },
          "currency": {
            "type": "string",
            "description": "Trading currency (ISO 4217)."
          },
          "assetType": {
            "type": "string",
            "description": "Kind of instrument: \u0060equity\u0060, \u0060etf\u0060 or \u0060other\u0060."
          }
        },
        "description": "The stock a watchlist item points to."
      },
      "WindowResponse": {
        "required": [
          "window",
          "change",
          "baselineDate",
          "reason"
        ],
        "type": "object",
        "properties": {
          "window": {
            "type": "string",
            "description": "One of \u00601D\u0060, \u00601W\u0060, \u00601M\u0060, \u00603M\u0060, \u00606M\u0060, \u0060YTD\u0060, \u00601Y\u0060, \u00605Y\u0060."
          },
          "change": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "type": [
              "null",
              "string"
            ],
            "description": "The change as a fraction (a decimal string; \u00600.0123\u0060 is 1.23 %), or null when there is a reason.",
            "format": "decimal"
          },
          "baselineDate": {
            "type": [
              "null",
              "string"
            ],
            "description": "The day of the close the change is measured from, or null.",
            "format": "date"
          },
          "reason": {
            "type": [
              "null",
              "string"
            ],
            "description": "Why there is no change: \u0060no_data\u0060, \u0060insufficient_history\u0060, \u0060history_gap\u0060 or \u0060calendar_unavailable\u0060; null when there is one."
          }
        },
        "description": "One performance window of a stock, from adjusted closes (ADR-0006, ADR-0030)."
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "description": "A Clavaris access token (RS256).",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
