{
  "openapi": "3.1.1",
  "info": {
    "title": "Saker Watch API",
    "description": "Personal stock watchlist and research assistant. Signals are research aids, never financial advice.",
    "version": "1.0"
  },
  "paths": {
    "/v1/me": {
      "get": {
        "tags": [
          "Me"
        ],
        "summary": "Get the current user",
        "description": "Returns the profile of the authenticated caller. The account is created on the first authenticated request.",
        "operationId": "GetMe",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "MeResponse": {
        "required": [
          "id",
          "displayName",
          "email",
          "locale",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Internal user id (UUIDv7), never the identity provider\u0027s subject.",
            "format": "uuid"
          },
          "displayName": {
            "type": [
              "null",
              "string"
            ],
            "description": "Name sent by the identity provider, if any."
          },
          "email": {
            "type": [
              "null",
              "string"
            ],
            "description": "Email sent by the identity provider, if any."
          },
          "locale": {
            "type": "string",
            "description": "Preferred UI locale (BCP 47), for example \u0060es-GT\u0060."
          },
          "createdAt": {
            "type": "string",
            "description": "When the account was first seen (ISO-8601 UTC).",
            "format": "date-time"
          }
        },
        "description": "The caller\u0027s own profile."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "description": "A Clavaris access token (RS256).",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [
    {
      "name": "Me"
    }
  ]
}
