root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md,ts,tsx,js,mjs,css,html,sh,csproj,props,targets}]
indent_size = 2

[Makefile]
indent_style = tab

[*.cs]
csharp_style_namespace_declarations = file_scoped:error
csharp_using_directive_placement = outside_namespace:warning
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_sort_system_directives_first = true
dotnet_style_qualification_for_field = false:warning
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA1848.severity = suggestion
# async methods should take CancellationToken (enforced by review + analyzer CA2016)
dotnet_diagnostic.CA2016.severity = warning
dotnet_diagnostic.CA1062.severity = none

[tests/**.cs]
# Test names use Method_Scenario_Expected (docs/code-standards.md)
dotnet_diagnostic.CA1707.severity = none

[src/**.cs]
# ADR-0016: log message templates only; banned APIs are errors
dotnet_diagnostic.CA2254.severity = error
dotnet_diagnostic.RS0030.severity = error
# SonarCloud's quality profile (S1192) fails the CI build on repeated string literals; enable it locally so it fails before pushing
dotnet_diagnostic.S1192.severity = error
# Limit of docs/code-standards.md: a method has at most 40 lines of code (threshold in SonarLint.xml). A method that needs more is marked
# with [SuppressMessage] and a Justification (the list of those marks is the debt, and it may only shrink). The build enforces 7 parameters (S107), not the 5 of the guideline: aggregate factories and constructors legitimately take more
dotnet_diagnostic.S138.severity = error
# SonarCloud's quality profile also fails the CI build on more than 7 parameters (S107, the analyzer's default threshold); enable it locally so it fails before pushing
dotnet_diagnostic.S107.severity = error
# SonarCloud's quality profile fails the CI build on a cognitive complexity over 15 (S3776, the analyzer's default); enable it locally so it fails before pushing
dotnet_diagnostic.S3776.severity = error
# C#-only code base: "Error" is the established name for the Result error type (VB keyword clash is irrelevant)
dotnet_diagnostic.CA1716.severity = none

[{**/Platform/Migrations/*.cs,**/Persistence/Migrations/*.cs}]
# EF-generated migrations and snapshots are regenerated by tooling; analyzers skip them (hand-written SQL migrations stay small)
generated_code = true
# Migrations are long lists of schema steps, not logic
dotnet_diagnostic.S138.severity = none
